{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tobiwebdeveloper.github.io/paraxe-registry/registry-index.schema.json",
  "title": "Paraxe registry release index",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "version",
    "license",
    "packageVersions",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "const": "paraxe"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "license": {
      "const": "MIT"
    },
    "packageVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "framework",
          "file",
          "sha256",
          "title",
          "description",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "framework": {
            "enum": [
              "vue",
              "react"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "experimental",
              "stable"
            ]
          }
        }
      }
    }
  }
}
