{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tobiwebdeveloper.github.io/paraxe-registry/registry-bundle-v2.schema.json",
  "title": "Paraxe registry schema 2 source bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "name",
    "framework",
    "license",
    "dependencies",
    "packageVersions",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "framework": {
      "enum": [
        "vue",
        "react"
      ]
    },
    "license": {
      "const": "MIT"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packageVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "content",
          "encoding",
          "sha256"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "encoding": {
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "encoding": {
                  "const": "base64"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "pattern": "^public/"
                },
                "content": {
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Installers additionally enforce canonical base64, decoded-byte SHA-256, safe paths, duplicate/overwrite/link protection, and bounded downloads. A JSON Schema check alone is not an installation preflight."
}
